# Ignore backup files
*.backup*

# Byte-compiled / cache
__pycache__/
*.pyc

# Environment files
.env
.venv/

# ReportBro assets generated via bootstrap
app/static/reportbro-designer/

# Ignore logs, reports, and databases
logs/
reports/

# Generated previews
*.pdf

# Databases (tudo)
databases/
databases/backups/
databases/images/

# Exceções específicas (se precisares manter algum ficheiro exemplo)
!/databases/*/
!/databases/allergens.example.json

# Local captures / screenshots
artifacts/

# Imports
imports/

# Python caches por módulos
domain/__pycache__/
services/__pycache__/
ui/__pycache__/
utils/__pycache__/
.DS_Store
**/.DS_Store
